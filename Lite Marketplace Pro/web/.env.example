# Leave empty when the website and API share a domain (recommended, see docs/DEPLOY.md).
# Set it when the API lives elsewhere, e.g. https://api.yourdomain.com
VITE_API_URL=

# true = the whole app runs in the browser with sample data (no backend needed).
# Perfect for a free live demo on Netlify / Vercel / GitHub Pages.
VITE_DEMO_MODE=false
