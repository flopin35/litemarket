# ──────────────────────────────────────────────────────────────────────────────
# Lite Marketplace settings. Copy this file to ".env" and fill it in.
# Never commit .env or share it: it holds your secret keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── Website ──────────────────────────────────────────────────────────────────
BRAND_NAME=Lite Marketplace
SUPPORT_EMAIL=support@example.com
# The public address of your site (used for payment redirects, shop links, emails)
WEB_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080
# Country code added to local phone numbers (024... -> 23324...). 233 = Ghana, 234 = Nigeria, 254 = Kenya
DEFAULT_COUNTRY_CODE=233

# ── Security (CHANGE BOTH before going live) ─────────────────────────────────
# At least 32 random characters. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-secret-0123456789-abcdefghijklmnop
# Set to true when your site runs on https://
SECURE_COOKIES=false
# Shared secret between the Java API and the Python AI service
AI_INTERNAL_KEY=change-me-internal-key

# ── Database (docker-compose starts PostgreSQL for you) ──────────────────────
DB_USER=litemarket
DB_PASSWORD=change-me-db-password

# ── First admin + demo shop (created on an empty database) ───────────────────
DEMO_SEED=true
ADMIN_EMAIL=admin@litemarket.dev
ADMIN_PASSWORD=admin12345

# ── Plans ────────────────────────────────────────────────────────────────────
PLAN_CURRENCY=GHS
FREE_PRODUCT_LIMIT=5
FREE_AI_CREDITS=50
PAID_AI_CREDITS=2000
# Plan names, prices and lengths are in backend/src/main/resources/application.yml (app.plans.paid)

# ── Payments ─────────────────────────────────────────────────────────────────
# Demo mode adds a "Demo payment" button that simulates paying. Turn OFF in production.
PAYMENTS_DEMO_MODE=true
# Your commission on customer orders, in percent (0 = sellers keep everything)
COMMISSION_PERCENT=0

# Paystack: dashboard > Settings > API Keys & Webhooks (use sk_test_... first)
PAYSTACK_SECRET_KEY=
# Flutterwave: dashboard > Settings > API keys (use FLWSECK_TEST-... first)
FLUTTERWAVE_SECRET_KEY=
# Flutterwave: dashboard > Settings > Webhooks > Secret hash (any long random text you choose)
FLUTTERWAVE_WEBHOOK_HASH=
# Stripe: dashboard > Developers > API keys (sk_test_...) and Webhooks (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI ───────────────────────────────────────────────────────────────────────
# auto = Claude if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else the built-in engine
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Any OpenAI-compatible server works too (Groq, Together, a local Ollama...)
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Email (optional: without it, emails are written to the API log) ──────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Lite Marketplace <no-reply@example.com>
